{
  "_comment": "App Runner のインスタンスロールに付ける権限。ACCOUNT と REGION は使う環境の値に置き換える(README の手順を参照)",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTenonakaParameters",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:REGION:ACCOUNT:parameter/tenonaka/*"
    },
    {
      "Sid": "DecryptOnlyViaSsm",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "kms:ViaService": "ssm.REGION.amazonaws.com" }
      }
    }
  ]
}
