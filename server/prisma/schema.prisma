generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 海に流す手紙。
///
/// 宛先を持たない。流すときに書いた人の脈が刻まれ、
/// 見知らぬ誰かが拾って読み、読み終えたときの脈と握っていた時間が返る。
/// 返信は持たない。返るのは身体の事実だけ。
model Letter {
  id           String   @id @default(uuid())
  /// 手紙の識別子。UI には出さないが、読み直しの取得に使う
  code         String   @unique
  body         String
  senderName   String?
  /// 宛名。海に流すので相手は決まっていないが「だれかへ」と書ける
  recipientName String?
  /// 流した瞬間の脈。生きた身体が流した証
  senderBpm    Float?
  senderUserId String
  sentAt       DateTime @default(now())

  /// 拾った端末。瓶は一人にしか拾われない。
  /// null のあいだが「まだ海にある」状態
  claimedByUserId String?
  claimedAt       DateTime?

  /// 読まれた記録。まだ読まれていなければ null
  readHeldSeconds  Float?
  readReleaseCount Int?
  readCompleted    Boolean?
  /// 読み終えたときの読み手の脈。手紙の効果が読んだ人の身体で測られる
  readReaderBpm    Float?
  readAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderUserId, sentAt])
  /// 海から拾うときに引く索引(まだ拾われていない手紙)
  @@index([claimedByUserId, sentAt])
}
