generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 住所。
///
/// 端末ごとに一度だけ発行し、以後変わらない。現実の住所と同じく、
/// 知っている相手からは誰でも手紙が届く。
/// 意味のある言葉を3つ繋いだ形(komorebi-nagisa-shigure)。
model Address {
  address   String   @id
  userId    String   @unique
  createdAt DateTime @default(now())
}

/// 手紙。
///
/// 送るときに書いた人の脈が刻まれ(生きた身体が送った証)、
/// 読まれたときに「生きた手が何秒握っていたか」が返る。
/// 内容への返信は持たない。返るのは費やされた時間だけ。
model Letter {
  id            String   @id @default(uuid())
  /// 受け取る人に口で伝える短い符号
  code          String   @unique
  body          String
  senderName    String?
  recipientName String?
  /// 宛先の住所。指定して送った場合、受取人は作成時点で確定する
  /// (符号を推測される余地が無くなる)
  recipientAddress String?
  /// 封をした瞬間の脈
  senderBpm     Float?
  senderUserId  String
  sentAt        DateTime @default(now())

  /// 最初に開いた端末。手渡しは一人にしか渡せないので、以後は他から読めない。
  /// 符号を総当たりしても、当たった手紙のほとんどが既に受け取られ済みになる。
  claimedByUserId String?
  claimedAt       DateTime?

  /// 読まれた記録。まだ読まれていなければ null
  readHeldSeconds  Float?
  readReleaseCount Int?
  readCompleted    Boolean?
  readAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderUserId, sentAt])
}
